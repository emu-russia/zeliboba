// zeliboba_ui - Windows resources for the SDL3 frontend.
//
// The icon comes from artwork/make_artwork.py; the SDL window itself sets the
// same artwork at runtime from src/ui/zeliboba_icon_pixels.h.
#include <windows.h>

#define IDI_ZELIBOBA 101

IDI_ZELIBOBA ICON "..\\..\\artwork\\zeliboba.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "zeliboba"
            VALUE "FileDescription",  "zeliboba - PlayStation Vita emulator (SDL3 frontend)"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "zeliboba_ui"
            VALUE "LegalCopyright",   "Built from open documentation on the device"
            VALUE "OriginalFilename", "zeliboba_ui.exe"
            VALUE "ProductName",      "zeliboba"
            VALUE "ProductVersion",   "0.1.0.0"
            VALUE "Comments",         "CMeP / Cortex-A9 / Ernie, firmware 1.04 bring-up"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
